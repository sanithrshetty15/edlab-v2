/*
 * Edwins Lab ESP32 Firmware — Main Entry Point
 * 
 * Integrates with Go backend API at /api/v1/...
 * 
 * API Contracts Referenced:
 *   POST  /api/v1/auth/member-login       {login_type, login_id, password}
 *   POST  /api/v1/auth/admin-login        {email, password}
 *   GET   /api/v1/auth/me                 Bearer token
 *   
 *   POST  /api/v1/device/authenticate     X-Device-Token header
 *   POST  /api/v1/biometric/enroll        {member_id, fingerprint_template, device_user_id}
 *   POST  /api/v1/biometric/event         {device_id, event_type, idempotency_key, 
 *                                           member_identifier, event_timestamp, hmac_signature?, payload}
 *   Allowed event_types: fingerprint_scan, finger_mismatch, enrollment_success, enrollment_failure
 *   
 *   POST  /api/v1/members-management      {admin-only} creates member
 *   
 *   POST  /api/v1/device/heartbeat        {device_id, status}
 *   
 *   POST  /api/v1/biometric/sync          Sync pending events when connectivity restores
 *   
 *   POST  /api/v1/attendance/record       {admin-only} manual attendance recording
 *   
 * HARDWARE:
 *   - ESP32-WROOM-32UE (ALF V1.0 custom board)
 *   - Two R307S UART fingerprint sensors (UART1, UART2)
 *   - Electromagnetic door lock + relay module
 *   - Emergency exit push button (with debouncing)
 *   - Status LEDs (green/red) + buzzer
 *   - Wi-Fi connectivity
 */

#include "config.h"
#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include "R307S.h"
#include "wifi_manager.cpp"
#include "device_auth.cpp"

// Global instances
R307S fingerprintReader1(1, R307S1_RX, R307S1_TX);
R307S fingerprintReader2(2, R307S2_RX, R307S2_TX);

// State machine
enum SystemMode { MODE_IDLE, MODE_ENROLLMENT, MODE_ATTENDANCE, MODE_EMERGENCY };
SystemMode currentMode = MODE_IDLE;

// Attendance tracking
struct AttendanceSession {
  int memberId;
  String memberLoginId;
  String memberName;
  USN usn;  // University Serial Number
  time_t loginTime;
  time_t logoutTime;
  bool hasLoggedOut;
} currentSession;

// Fingerprint enrollment tracking
struct EnrollmentSession {
  int memberId;
  int scanCount;
  int totalScans;  // Typically 3
  String deviceUserId;
  bool completed;
} currentEnrollment;

// ---------------------------------------------------------------------------
// WiFi & System
// ---------------------------------------------------------------------------

// setup() and loop() are defined in CompleteFirmware.ino as the main entry point
// This file provides firmware logic, state machines, and API integration functions

// ---------------------------------------------------------------------------
// Attendance Scanning Logic
// ---------------------------------------------------------------------------

void handleAttendanceScanning() {
  // Reader 1 = Login (scan continuously)
  // Reader 2 = Logout (scan continuously)
  
  // Scan Reader 1 (Login)
  bool reader1Result = scanFingerprintReader(fingerprintReader1);
  if (reader1Result) {
    // Fingerprint matched on Reader 1
    recordLoginScan();
  }
  
  // Scan Reader 2 (Logout)  
  bool reader2Result = scanFingerprintReader(fingerprintReader2);
  if (reader2Result) {
    // Fingerprint matched on Reader 2
    recordLogoutScan();
  }
}

// Scan a single R307S reader and return true if fingerprint matched
bool scanFingerprintReader(R307S& reader) {
  uint8_t buffer[256];
  int matchedId = -1;
  
  // Get image from sensor
  if (!reader.getImage(buffer)) {
    return false;
  }
  
  // Convert image to template
  if (!reader.img2tz(buffer)) {
    return false;
  }
  
  // Search for match
  if (reader.searchMatch(buffer, matchedId)) {
    // Fingerprint matched! Return the matched ID
    return matchedId > 0;
  }
  
  return false;
}

// ---------------------------------------------------------------------------
// Login Flow
// ---------------------------------------------------------------------------

void recordLoginScan() {
  // Check if we already have an active session
  if (currentSession.hasLoggedOut == false && currentSession.loginTime > 0) {
    // Already logged in, ignore duplicate
    buzzPattern(3); // Error: already logged in
    return;
  }
  
  // Authenticate device first
  if (!authenticateDevice()) {
    buzzPattern(2); // Auth failed
    return;
  }
  
  // Send fingerprint scan event to backend
  // The backend will validate the member and record the login
  bool success = recordBiometricEvent(
    "fingerprint_scan",        // event_type
    "",                        // member_identifier (backend resolves from device + session)
    "login_" + String(millis()), // idempotency_key
    "{}"
  );
  
  if (success) {
    // Backend responded successfully - member is authorized
    // Record login with server timestamp
    currentSession.memberId = /* from backend response */ 0;
    currentSession.memberLoginId = /* from backend */ "";
    currentSession.memberName = /* from backend */ "";
    currentSession.usn = /* from backend */ "";
    currentSession.loginTime = time(nullptr);
    currentSession.hasLoggedOut = false;
    
    // Unlock the door
    digitalWrite(RELAY_PIN, HIGH); // Unlock
    
    // Green LED + success buzz
    setLEDStatus(true, false, true);
    buzzPattern(2);
    
    Serial.println("Login recorded successfully");
  } else {
    // Backend rejected - could be invalid member, no access, etc.
    setLEDStatus(true, true, true);
    buzzPattern(3); // Error pattern
    Serial.println("Login scan rejected by backend");
  }
}

// ---------------------------------------------------------------------------
// Logout Flow
// ---------------------------------------------------------------------------

void recordLogoutScan() {
  // Must have an active login session
  if (!currentSession.hasLoggedOut && currentSession.loginTime > 0) {
    // Authenticate device
    if (!authenticateDevice()) {
      buzzPattern(2);
      return;
    }
    
    // Send logout event to backend
    // Backend verifies active login, records logout, calculates duration
    bool success = recordBiometricEvent(
      "fingerprint_scan",
      "",
      "logout_" + String(millis()),
      "{}"
    );
    
    if (success) {
      // Record logout
      currentSession.logoutTime = time(nullptr);
      currentSession.hasLoggedOut = true;
      
      // Door stays unlocked during access window (handled by backend timer)
      // but we don't re-lock immediately
      
      // Green success
      setLEDStatus(true, false, true);
      buzzPattern(2);
      Serial.println("Logout recorded successfully");
    } else {
      setLEDStatus(true, true, true);
      buzzPattern(3);
      Serial.println("Logout rejected by backend");
    }
  } else {
    // No active session - reject
    buzzPattern(3);
    Serial.println("Logout rejected: no active login session");
  }
}

// ---------------------------------------------------------------------------
// Enrollment Flow
// ---------------------------------------------------------------------------

void beginEnrollment(int memberId) {
  currentEnrollment.memberId = memberId;
  currentEnrollment.scanCount = 0;
  currentEnrollment.totalScans = 3; // Typical enrollment requires 3 scans
  currentEnrollment.deviceUserId = "";
  currentEnrollment.completed = false;
  
  currentMode = MODE_ENROLLMENT;
  enrollFingerprintBegin(memberId);
}

// Enroll a fingerprint via the R307S sensor
void enrollNextScan() {
  if (currentMode != MODE_ENROLLMENT) return;
  if (currentEnrollment.completed) return;
  
  // Read from R307S
  uint8_t buffer[256];
  if (!fingerprintReader1.getImage(buffer)) {
    // Try reader 2
    if (!fingerprintReader2.getImage(buffer)) {
      buzzPattern(1); // Error: no finger detected
      return;
    }
  }
  
  if (!fingerprintReader1.img2tz(buffer)) {
    if (!fingerprintReader2.img2tz(buffer)) {
      buzzPattern(1);
      return;
    }
  }
  
  // Create model (combine two half-templates)
  if (!fingerprintReader1.regModel()) {
    if (!fingerprintReader2.regModel()) {
      buzzPattern(2); // Error creating model
      return;
    }
  }
  
  // Send enrollment data to backend
  currentEnrollment.scanCount++;
  
  if (currentEnrollment.scanCount >= currentEnrollment.totalScans) {
    // Enrollment complete - send to backend
    enrollFingerprintComplete();
  } else {
    // Prompt for next scan
    buzzPattern(1); // Short beep indicating scan accepted
  }
}

void enrollFingerprintComplete() {
  // Send enrollment request to backend
  HTTPClient http;
  http.begin(API_BASE_URL + "/api/v1/biometric/enroll");
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Token", deviceToken);
  
  String jsonPayload = "{\"member_id\": " + String(currentEnrollment.memberId) + 
                       ",\"fingerprint_template\": \"template_ref_placeholder_" + 
                       String(currentEnrollment.scanCount) + "\"," +
                       "\"device_user_id\": \"" + currentEnrollment.deviceUserId + "\"}";
  
  int httpCode = http.POST(jsonPayload);
  String response = "";
  
  if (httpCode > 0) {
    response = http.getString();
  }
  http.end();
  
  if (httpCode == HTTP_CODE_OK) {
    StaticJsonDocument<200> doc;
    deserializeJson(doc, response);
    
    if (doc["success"].as<bool>()) {
      Serial.println("Fingerprint enrollment confirmed by backend");
      currentEnrollment.completed = true;
      currentMode = MODE_IDLE;
      setLEDStatus(true, false, true); // Green
      buzzPattern(2);
    } else {
      Serial.print("Enrollment rejected: ");
      Serial.println(doc["message"].as<String>());
      setLEDStatus(true, true, true);
      buzzPattern(3);
    }
  } else {
    Serial.println("HTTP error during enrollment");
    setLEDStatus(true, true, true);
    buzzPattern(3);
  }
  
  currentMode = MODE_IDLE;
}

// ---------------------------------------------------------------------------
// Emergency Exit
// ---------------------------------------------------------------------------

void handleEmergencyExit() {
  // Immediately release electromagnetic lock
  digitalWrite(RELAY_PIN, LOW); // Fail-safe: power off = lock releases
  
  // Override any attendance state
  currentMode = MODE_EMERGENCY;
  
  // Set emergency LED/buzzer pattern
  setLEDStatus(false, true, true); // Red + buzzer
  
  // Buzz 3 long bursts
  for (int i = 0; i < 3; i++) {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(400);
    digitalWrite(BUZZER_PIN, LOW);
    delay(100);
  }
  
  // Send emergency audit event to backend (when WiFi available)
  if (wifiConnected) {
    recordBiometricEvent(
      "emergency_exit",
      "",                       // member_identifier - no member logout
      "emergency_" + String(millis()),
      "{}"
    );
  }
  
  // After emergency, system returns to IDLE mode after a delay
  // The electromagnetic lock should remain in fail-safe state
  // (power removed = lock released). Re-lock only after manual intervention.
  
  Serial.println("Emergency exit activated - lock released");
  
  // Return to IDLE after emergency handling (requires manual re-lock)
  // In a full implementation, would wait for authorized re-enrollment or
  // manual reset via admin interface
}

// ---------------------------------------------------------------------------
// Heartbeat
// ---------------------------------------------------------------------------

void handleHeartbeat() {
  if (!authenticateDevice()) {
    Serial.println("Heartbeat: device authentication failed");
    setLEDStatus(true, true, true);
    return;
  }
  
  // Send heartbeat to backend
  HTTPClient http;
  http.begin(API_BASE_URL + "/api/v1/device/heartbeat");
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Token", deviceToken);
  
  String jsonPayload = "{\"device_id\": " + String(deviceId) + 
                       ",\"status\": \"online\"}";
  
  int httpCode = http.POST(jsonPayload);
  String response = "";
  
  if (httpCode > 0) {
    response = http.getString();
  }
  http.end();
  
  if (httpCode == HTTP_CODE_OK) {
    // Serial.println("Heartbeat OK");
  } else {
    Serial.print("Heartbeat failed: "); Serial.println(httpCode);
    if (httpCode == 401 || httpCode == 403) {
      // Re-authenticate
      authenticateDevice();
    }
  }
  
  setLEDStatus(true, false, false); // Green while authenticated
}

// ---------------------------------------------------------------------------
// LED & Buzzer Helpers
// ---------------------------------------------------------------------------

void setLEDStatus(bool green, bool red, bool buzzer) {
  digitalWrite(LED_GREEN, green ? HIGH : LOW);
  digitalWrite(LED_RED, red ? HIGH : LOW);
  digitalWrite(BUZZER_PIN, buzzer ? HIGH : LOW);
}

void buzzPattern(int pattern) {
  switch (pattern) {
    case 1: // Short beep
      digitalWrite(BUZZER_PIN, HIGH);
      delay(50);
      digitalWrite(BUZZER_PIN, LOW);
      break;
    case 2: // Two quick beeps
      for (int i = 0; i < 2; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(50);
        digitalWrite(BUZZER_PIN, LOW);
        delay(30);
      }
      break;
    case 3: // Three beeps (error)
      for (int i = 0; i < 3; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(50);
        digitalWrite(BUZZER_PIN, LOW);
        delay(30);
      }
      break;
    case 4: // Long emergency burst
      digitalWrite(BUZZER_PIN, HIGH);
      delay(400);
      digitalWrite(BUZZER_PIN, LOW);
      break;
  }
}

// ---------------------------------------------------------------------------
// Helper: Parse USN from identifier strings
// ---------------------------------------------------------------------------

struct USN {
  String value;
  bool valid;
  
  USN() : valid(false) {}
  
  static bool parse(const String& id, USN& out) {
    // USN format: 22H51A05935 (5 digits + 1 letter + 3 digits + 1 letter + 2 digits)
    // Or various formats used by the institution
    if (id.length() < 8) return false;
    
    // Basic validation - check for alphanumeric pattern
    for (int i = 0; i < id.length(); i++) {
      if (!isAlnum(id[i])) return false;
    }
    
    out.value = id;
    out.valid = true;
    return true;
  }
};

// ---------------------------------------------------------------------------
// Entry point helpers
// ---------------------------------------------------------------------------

/*
 * Firmware API Summary for External Integration:
 * 
 * 1. init() - Call in Arduino setup()
 * 2. loop() - Call in Arduino loop()
 * 3. beginEnrollment(memberId) - Start fingerprint enrollment
 * 4. enrollNextScan() - Process next enrollment scan
 * 5. recordLoginScan() - Record login via fingerprint
 * 6. recordLogoutScan() - Record logout via fingerprint
 * 7. handleEmergencyExit() - Emergency egress (fail-safe lock release)
 * 8. checkIn() / checkOut() - Aliases for above
 * 
 * All API calls use the backend contracts documented above.
 * Device authentication via X-Device-Token header is required for
 * all biometric and attendance endpoints.
 */

#endif // FIRMWARE_MAIN_H