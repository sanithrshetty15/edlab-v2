# Edwins Lab Go Backend - Environment Variables
# Copy this file to .env and fill in actual values.
# Never commit real credentials.

# === Core Application ===
APP_ENV=development
PORT=8080
APP_TIMEZONE=Asia/Kolkata
JWT_SECRET=change-me-to-a-random-value-at-least-32-characters
SESSION_SECRET=change-me-to-a-random-value-at-least-32-characters
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Database ===
# Required in production. Point this at the new deployment database; do not
# repoint an upgraded backend at the old database during cutover.
DATABASE_URL=postgres://edwinslab:password@localhost:5432/edwinslab?sslmode=disable

# === Admin Authentication ===
# Required: passwords for the two initial administrators.
# Run once with ADMIN_BOOTSTRAP_RESET_PASSWORDS=true to provision/reset them.
ADMIN_ONE_PASSWORD=change-me-admin-one
ADMIN_TWO_PASSWORD=change-me-admin-two
ADMIN_BOOTSTRAP_RESET_PASSWORDS=false

# === Email (Resend or Gmail SMTP) ===
RESEND_API_KEY=change-me-resend-api-key
GMAIL_USERNAME=edwin.lab.aiet@gmail.com
GMAIL_APP_PASSWORD=change-me-gmail-app-password
MAILER_FROM=Edwins Lab <edwin.lab.aiet@gmail.com>

# === Administrator Google Sign-In (OIDC) ===
# Create a separate Google OAuth 2.0 Web application client for administrator
# sign-in. Do not reuse the Gmail API sending client or credentials.
GOOGLE_LOGIN_CLIENT_ID=change-me-google-login-client-id
GOOGLE_LOGIN_CLIENT_SECRET=change-me-google-login-client-secret
GOOGLE_LOGIN_REDIRECT_URL=http://localhost:8080/api/v1/oauth/google/callback

# === Twilio Verify (SMS phone verification) ===
TWILIO_ACCOUNT_SID=change-me-twilio-account-sid
TWILIO_AUTH_TOKEN=change-me-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=change-me-twilio-verify-service-sid

# === OTP / Sessions ===
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=900
OTP_MAX_REQUESTS=5
OTP_TEST_RECIPIENT=
SESSION_TTL_SECONDS=86400
ADMIN_SESSION_TTL_SECONDS=86400

# === File/Storage ===
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520

# === Biometric Device Authentication ===
BIOMETRIC_API_SECRET=change-me-device-auth-secret

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
