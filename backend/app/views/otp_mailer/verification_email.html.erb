<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edwins Lab Verification</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: Arial, Helvetica, sans-serif; color: #1e293b;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
         style="background-color: #f1f5f9; padding: 35px 15px;">

    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0"
               style="max-width: 560px; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="padding: 30px 25px 22px;">
              <img
                src="<%= attachments['edwins.png'].url %>"
                alt="Edwins Lab"
                width="260"
                style="display: block; width: 100%; max-width: 260px; height: auto; border: 0;"
              >
            </td>
          </tr>

          <!-- Blue accent -->
          <tr>
            <td style="height: 4px; background-color: #2563eb;"></td>
          </tr>

          <!-- Main content -->
          <tr>
            <td style="padding: 35px 35px 20px;">

              <p style="font-size: 14px; color: #64748b; margin: 0 0 10px;">
                ACCOUNT VERIFICATION
              </p>

              <h1 style="font-size: 25px; line-height: 1.3; color: #0f172a; margin: 0 0 18px;">
                Verify your email address
              </h1>

              <p style="font-size: 15px; line-height: 1.7; color: #475569; margin: 0 0 25px;">
                Hello <strong><%= @user.email %></strong>,
                <br><br>
                We received a request to verify your account with Edwins Lab.
                Use the verification code below to continue.
              </p>

              <!-- OTP box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center"
                      style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 25px 15px;">

                    <p style="font-size: 12px; font-weight: bold; letter-spacing: 2px; color: #64748b; margin: 0 0 12px;">
                      YOUR VERIFICATION CODE
                    </p>

                    <p style="font-size: 36px; font-weight: bold; letter-spacing: 10px; color: #1d4ed8; margin: 0;">
                      <%= @code %>
                    </p>

                  </td>
                </tr>
              </table>

              <p style="font-size: 14px; line-height: 1.7; color: #475569; margin: 25px 0;">
                This code is valid for <strong>5 minutes</strong>.
                Please do not share it with anyone.
              </p>

              <p style="font-size: 13px; line-height: 1.6; color: #64748b; margin: 0;">
                If you did not request this verification code, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 22px 30px; text-align: center; border-top: 1px solid #e2e8f0;">

              <p style="font-size: 13px; font-weight: bold; color: #334155; margin: 0 0 7px;">
                Edwins Lab
              </p>

              <p style="font-size: 12px; color: #94a3b8; line-height: 1.6; margin: 0;">
                Open Source Technology Lab
                <br>
                This is an automated message. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>

  </table>

</body>
</html>