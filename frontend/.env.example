# Edwins Lab Frontend — Environment Variables
# Copy this file to .env and fill in actual values.
# Never commit real credentials.

# Production API URL (used when VITE_API_BASE_URL is not set)
PRODUCTION_API_URL=https://edwinslab.onrender.com

# Vite will use VITE_API_BASE_URL for the development/production API base URL
# Set this to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://edwinslab.onrender.com